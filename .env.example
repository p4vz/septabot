# Optional: 511PA API key for the traffic events JSON feed.
# Without this, /traffic and /commute return an empty traffic list.
# Request a key at https://www.511pa.com/developers
PA511_API_KEY=

# Default location used when lat/lon are not passed (Philadelphia City Hall).
DEFAULT_LAT=39.9526
DEFAULT_LON=-75.1652

# NWS (api.weather.gov) requires a descriptive User-Agent with contact info.
NWS_USER_AGENT=septabot (https://github.com/p4vz/septabot, contact@example.com)

# Cache TTLs in seconds.
CACHE_TTL_ALERTS=60
CACHE_TTL_TRAINS=20
CACHE_TTL_WEATHER=600
CACHE_TTL_TRAFFIC=120

# Outbound HTTP timeout in seconds.
HTTP_TIMEOUT=10

# Telegram bot. Create via @BotFather.
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Hermes inference endpoint (OpenAI-compatible /v1/chat/completions).
# Point this at your Railway-hosted Hermes service (vLLM, TGI, llama.cpp server, etc.).
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-3-llama-3.1-8b
HERMES_MAX_TOKENS=220
HERMES_TEMPERATURE=0.3

# Google Maps Platform API key for /route/drive and /route/transit.
# Without this both endpoints return 502; the dashboard's other cards still work.
# Free $200/mo credit covers personal-bot usage easily. Create + restrict at
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
